  {
    "id": "a-3",
    "slug": "bevegelse-som-forklarer",
    "createdAt": "2026-11-10T09:00:00.000Z",
    "updatedAt": "2026-11-10T09:00:00.000Z",
    "status": "published",
    "_type": "article",
    "title": "Bevegelse som forklarer, ikke pynter",
    "summary": "Animasjon på nettsider skal vise rekkefølge, retning eller respons. Vi bruker sju navngitte oppskrifter – fra reveal til countUp – og alle har en fallback for brukere som har skrudd av bevegelse.",
    "image": {
      "url": "/images/article-3.svg",
      "alt": "Illustrasjon: bevegelse",
      "width": 1600,
      "height": 900
    },
    "authorId": "p-sara",
    "publishedAt": "2026-10-06T08:00:00.000Z",
    "categoryIds": ["c-design"],
    "body": [
      {
        "_type": "block",
        "style": "h2",
        "children": [
          {
            "_type": "span",
            "text": "Regelen",
            "marks": []
          }
        ]
      },
      {
        "_type": "block",
        "style": "normal",
        "children": [
          {
            "_type": "span",
            "text": "Hvis du ikke kan si hva en animasjon forklarer, fjern den. Det er den eneste regelen vi trenger.",
            "marks": []
          }
        ]
      },
      {
        "_type": "block",
        "style": "h2",
        "children": [
          {
            "_type": "span",
            "text": "Oppskriftene",
            "marks": []
          }
        ]
      },
      {
        "_type": "block",
        "style": "normal",
        "children": [
          {
            "_type": "span",
            "text": "Alle animasjoner i prosjektene våre kommer fra én fil, motion.ts. Det gjør at AI kan bruke dem riktig, og at hele siden beveger seg med samme rytme.",
            "marks": []
          }
        ]
      }
    ],
