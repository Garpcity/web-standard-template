    "id": "a-2",
    "slug": "hvorfor-vi-bygger-pa-apen-kildekode",
    "createdAt": "2026-11-10T09:00:00.000Z",
    "updatedAt": "2026-11-10T09:00:00.000Z",
    "status": "published",
    "_type": "article",
    "title": "Hvorfor vi bygger på åpen kildekode",
    "summary": "Alle kjernekomponenter i nettsidene våre har MIT- eller GPL-lisens og kan selvhostes. Da kan kunden flytte, forke og videreføre løsningen uansett hva som skjer med leverandøren – eller med oss.",
    "image": {
      "url": "/images/article-2.svg",
      "alt": "Illustrasjon: åpen kildekode",
      "width": 1600,
      "height": 900
    },
    "authorId": "p-martin",
    "publishedAt": "2026-10-20T08:00:00.000Z",
    "categoryIds": ["c-tech"],
    "body": [
      {
        "_type": "block",
        "style": "h2",
        "children": [
          {
            "_type": "span",
            "text": "Eieren kan endre seg. Lisensen består.",
            "marks": []
          }
        ]
      },
      {
        "_type": "block",
        "style": "normal",
        "children": [
          {
            "_type": "span",
            "text": "I 2026 ble Payload CMS kjøpt av Figma, og WordPress-prosjektet har hatt en langvarig styringskrise. Ingen av delene har stoppet prosjektene, fordi koden er åpen og kan forkes.",
            "marks": []
          }
        ]
      },
      {
        "_type": "block",
        "style": "h2",
        "children": [
          {
            "_type": "span",
            "text": "Det vi gjør",
            "marks": []
          }
        ]
      },
      {
        "_type": "block",
        "style": "normal",
        "listItem": "bullet",
        "level": 1,
        "children": [
          {
            "_type": "span",
            "text": "Next.js, Payload, Puck, Motion og Tailwind: alle MIT.",
            "marks": []
          }
        ]
      },
      {
        "_type": "block",
        "style": "normal",
        "listItem": "bullet",
        "level": 1,
        "children": [
          {
            "_type": "span",
            "text": "Kunden eier repo, database og domene. Vi har tilgang, ikke eierskap.",
            "marks": []
          }
        ]
      },
      {
        "_type": "block",
        "style": "normal",
        "listItem": "bullet",
        "level": 1,
        "children": [
          {
            "_type": "span",
            "text": "README beskriver hvordan en annen leverandør kan ta over.",
            "marks": []
          }
        ]
      }
    ],
    "sources": [],
