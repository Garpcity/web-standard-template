# Kopier til .env.local og fyll ut. Aldri sjekk inn .env.local.

# Hvilken CMS-adapter som er aktiv: mock | wordpress | payload
CMS_PROVIDER=payload   # payload (standard for nye kunder) | wordpress (migrasjon) | mock (utvikling/demo)

# Offentlig URL til siden (brukes i sitemap, canonical, JSON-LD)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- WordPress (CMS_PROVIDER=wordpress) ---
WORDPRESS_GRAPHQL_URL=http://localhost:8080/graphql
# Valgfri; utledes fra GraphQL-URL hvis tom
WORDPRESS_REST_URL=
# Application Password for brukeren Puck lagrer som (Brukere → Profil → Application Passwords)
WORDPRESS_APP_USER=
WORDPRESS_APP_PASSWORD=
WORDPRESS_PREVIEW_SECRET=change-me

# --- Payload (CMS_PROVIDER=payload) ---
# Produksjon: postgres://… (migrasjoner). Lokalt/CI: tom eller file:./payload.db (SQLite, schema pushes i dev)
DATABASE_URL=file:./payload.db
PAYLOAD_SECRET=change-me
# Første bruker opprettes av seed (POST /api/seed med header x-payload-secret, eller pnpm seed:payload på Node 24)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-now

# --- Skjemaer: webhook n8n tar imot innsendinger på ---
FORMS_WEBHOOK_URL=
FORMS_WEBHOOK_SECRET=

# --- Puck-editor: enkel beskyttelse av /edit i dev/staging ---
EDITOR_PASSWORD=change-me

# --- Analytics (Plausible/Umami) ---
NEXT_PUBLIC_ANALYTICS_DOMAIN=
NEXT_PUBLIC_ANALYTICS_SCRIPT=

# --- MCP for kundens agenter (POST /api/mcp) ---
# navn:nøkkel[:rolle], kommaseparert. Rolle agent = lese + utkast (standard).
AGENT_API_KEYS=kunde-ai:change-me
REVALIDATE_SECRET=bytt-meg   # samme verdi i WordPress: SITE_CORE_REVALIDATE_SECRET

# Feilrapport og metrikker til Studio (valgfritt)
STUDIO_URL=
STUDIO_API_KEY=
SITE_SLUG=
