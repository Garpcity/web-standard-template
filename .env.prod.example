# Kopier til .env.prod på serveren. Generer hemmeligheter med: openssl rand -hex 32
# Kanonisk domene = det nettsiden mener den heter (canonical, sitemap, llms.txt).
# Ny side: sett SITE_DOMAIN lik testdomenet. Ved lansering: bytt til ekte domene og bygg på nytt
# (docs/hosting-servetheworld.md, «Testdomene og flytting»). PREVIEW_DOMAIN svarer alltid, men noindex.
SITE_DOMAIN=admoment.preikestol.no
PREVIEW_DOMAIN=admoment.preikestol.no
STUDIO_DOMAIN=studio.trygo.no
SITE_SLUG=admoment

# Første admin-bruker (seed). Bytt passord etter innlogging.
SEED_ADMIN_EMAIL=kevin@garpcity.no
SEED_ADMIN_PASSWORD=

POSTGRES_PASSWORD=
SITE_PAYLOAD_SECRET=
STUDIO_PAYLOAD_SECRET=
REVALIDATE_SECRET=
STUDIO_API_KEY=
STUDIO_MCP_KEY=

# Kundens agenter: navn:nøkkel[:rolle], kommaseparert
AGENT_API_KEYS=

# n8n skjema-webhook (01-skjemainnsending)
FORMS_WEBHOOK_URL=https://garpcity.app.n8n.cloud/webhook/admoment-skjema
FORMS_WEBHOOK_SECRET=

# GitHub fine-grained PAT for Studio (opprett repo fra template, issues, PR-lesing)
GITHUB_TOKEN=
GITHUB_ORG=Garpcity

# GitHub-webhook til Studio (oppgavestatus uten polling). Samme verdi som «Secret» i repoets webhook.
GITHUB_WEBHOOK_SECRET=

# E-post fra nettsiden og Studio (glemt passord, invitasjoner). Tom SMTP_HOST = e-post skrives bare til logg.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
