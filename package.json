{
  "name": "web-standard-template",
  "version": "0.1.0",
  "private": true,
  "description": "Standard template for nettsideutvikling: Next.js + TypeScript + Tailwind + Puck + Motion, med utskiftbart CMS via innholdslaget.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lighthouse": "lhci autorun",
    "check": "pnpm lint && pnpm typecheck && pnpm format:check && pnpm test",
    "generate:schema": "tsx scripts/generate-schema.ts",
    "seed": "tsx scripts/seed.ts",
    "setup": "tsx scripts/setup.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/inter-tight": "^5.3.0",
    "@puckeditor/core": "0.24.0",
    "clsx": "2.1.1",
    "lucide-react": "1.71.0",
    "motion": "14.12.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "schema-dts": "2.1.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@lhci/cli": "0.16.0",
    "@playwright/test": "1.65.0",
    "@tailwindcss/turbopack": "4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "jsdom": "31.0.0",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "^5",
    "vitest": "5.1.0"
  },
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  }
}
