{
  "$comment": "Generert fra src/content/schema – ikke rediger manuelt",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "identity": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "oneLiner": {
          "type": "string",
          "maxLength": 200
        },
        "purpose": {
          "type": "string",
          "maxLength": 600
        },
        "values": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "audiences": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": ["name", "oneLiner", "purpose"]
    },
    "voice": {
      "type": "object",
      "properties": {
        "tone": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "language": {
          "default": "nb",
          "type": "string",
          "enum": ["nb", "nn", "en"]
        },
        "addressForm": {
          "default": "du",
          "type": "string",
          "enum": ["du", "dere", "De"]
        },
        "useWords": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "avoidWords": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "goodExamples": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "badExamples": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "facts": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "claim": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "approved": {
            "default": true,
            "type": "boolean"
          }
        },
        "required": ["claim"]
      }
    },
    "neverClaim": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "channels": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "format": {
            "type": "string"
          },
          "maxLength": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "frequency": {
            "type": "string"
          },
          "hashtags": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": ["name", "format"]
      }
    },
    "legal": {
      "type": "object",
      "properties": {
        "requiresApproval": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "forbiddenTopics": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "imageRights": {
          "type": "string"
        }
      }
    },
    "version": {
      "default": "1.0.0",
      "type": "string"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    }
  },
  "required": ["identity", "voice", "legal", "updatedAt"]
}
