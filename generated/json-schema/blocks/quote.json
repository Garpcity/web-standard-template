{
  "$comment": "Generert fra src/content/schema/blocks.ts – ikke rediger manuelt",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "anchor": {
      "type": "string"
    },
    "tone": {
      "default": "default",
      "type": "string",
      "enum": [
        "default",
        "muted",
        "brand",
        "dark"
      ]
    },
    "_type": {
      "type": "string",
      "const": "quote"
    },
    "quote": {
      "type": "string",
      "minLength": 1,
      "maxLength": 400
    },
    "author": {
      "type": "string",
      "maxLength": 80
    },
    "role": {
      "type": "string",
      "maxLength": 80
    },
    "image": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "minLength": 1
        },
        "alt": {
          "default": "",
          "type": "string"
        },
        "width": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "height": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "caption": {
          "type": "string"
        },
        "blurDataURL": {
          "type": "string"
        },
        "focal": {
          "type": "object",
          "properties": {
            "x": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "y": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "required": [
            "x",
            "y"
          ]
        }
      },
      "required": [
        "url",
        "width",
        "height"
      ]
    }
  },
  "required": [
    "id",
    "_type",
    "quote"
  ]
}
