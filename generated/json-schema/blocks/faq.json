{
  "$comment": "Generert fra src/content/schema/blocks.ts – ikke rediger manuelt",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "anchor": {
      "type": "string"
    },
    "tone": {
      "default": "default",
      "type": "string",
      "enum": ["default", "muted", "brand", "dark"]
    },
    "_type": {
      "type": "string",
      "const": "faq"
    },
    "heading": {
      "default": "Ofte stilte spørsmål",
      "type": "string",
      "maxLength": 120
    },
    "lead": {
      "type": "string",
      "maxLength": 300
    },
    "items": {
      "minItems": 1,
      "maxItems": 30,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "question": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "answer": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "_type": {
                      "type": "string",
                      "const": "block"
                    },
                    "style": {
                      "default": "normal",
                      "type": "string",
                      "enum": ["normal", "h2", "h3", "h4", "blockquote"]
                    },
                    "listItem": {
                      "type": "string",
                      "enum": ["bullet", "number"]
                    },
                    "level": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 3
                    },
                    "children": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "_type": {
                            "type": "string",
                            "const": "span"
                          },
                          "text": {
                            "type": "string"
                          },
                          "marks": {
                            "default": [],
                            "type": "array",
                            "items": {
                              "type": "string",
                              "enum": ["strong", "em", "code", "underline"]
                            }
                          },
                          "href": {
                            "type": "string"
                          }
                        },
                        "required": ["_type", "text"]
                      }
                    }
                  },
                  "required": ["_type", "children"]
                },
                {
                  "type": "object",
                  "properties": {
                    "_type": {
                      "type": "string",
                      "const": "image"
                    },
                    "image": {
                      "type": "object",
                      "properties": {
                        "url": {
                          "type": "string",
                          "minLength": 1
                        },
                        "alt": {
                          "default": "",
                          "type": "string"
                        },
                        "width": {
                          "type": "integer",
                          "exclusiveMinimum": 0,
                          "maximum": 9007199254740991
                        },
                        "height": {
                          "type": "integer",
                          "exclusiveMinimum": 0,
                          "maximum": 9007199254740991
                        },
                        "caption": {
                          "type": "string"
                        },
                        "blurDataURL": {
                          "type": "string"
                        },
                        "focal": {
                          "type": "object",
                          "properties": {
                            "x": {
                              "type": "number",
                              "minimum": 0,
                              "maximum": 1
                            },
                            "y": {
                              "type": "number",
                              "minimum": 0,
                              "maximum": 1
                            }
                          },
                          "required": ["x", "y"]
                        }
                      },
                      "required": ["url", "width", "height"]
                    }
                  },
                  "required": ["_type", "image"]
                }
              ]
            }
          }
        },
        "required": ["id", "question", "answer"]
      }
    }
  },
  "required": ["id", "_type", "items"]
}
