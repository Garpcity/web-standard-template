{
  "$comment": "Generert fra src/content/schema/blocks.ts – ikke rediger manuelt",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "anchor": {
      "type": "string"
    },
    "tone": {
      "default": "default",
      "type": "string",
      "enum": [
        "default",
        "muted",
        "brand",
        "dark"
      ]
    },
    "_type": {
      "type": "string",
      "const": "hero"
    },
    "eyebrow": {
      "type": "string",
      "maxLength": 60
    },
    "heading": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "lead": {
      "type": "string",
      "maxLength": 300
    },
    "image": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "minLength": 1
        },
        "alt": {
          "default": "",
          "type": "string"
        },
        "width": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "height": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "caption": {
          "type": "string"
        },
        "blurDataURL": {
          "type": "string"
        },
        "focal": {
          "type": "object",
          "properties": {
            "x": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "y": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "required": [
            "x",
            "y"
          ]
        }
      },
      "required": [
        "url",
        "width",
        "height"
      ]
    },
    "links": {
      "default": [],
      "maxItems": 2,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1
          },
          "href": {
            "type": "string",
            "minLength": 1
          },
          "external": {
            "default": false,
            "type": "boolean"
          },
          "variant": {
            "default": "primary",
            "type": "string",
            "enum": [
              "primary",
              "secondary",
              "ghost"
            ]
          }
        },
        "required": [
          "label",
          "href"
        ]
      }
    },
    "layout": {
      "default": "split",
      "type": "string",
      "enum": [
        "split",
        "centered",
        "fullBleed"
      ]
    }
  },
  "required": [
    "id",
    "_type",
    "heading"
  ]
}
