{
  "$comment": "Generert fra src/content/schema/blocks.ts – ikke rediger manuelt",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "anchor": {
      "type": "string"
    },
    "tone": {
      "default": "default",
      "type": "string",
      "enum": ["default", "muted", "brand", "dark"]
    },
    "_type": {
      "type": "string",
      "const": "cardGrid"
    },
    "heading": {
      "type": "string",
      "maxLength": 120
    },
    "lead": {
      "type": "string",
      "maxLength": 300
    },
    "columns": {
      "default": 3,
      "anyOf": [
        {
          "type": "number",
          "const": 2
        },
        {
          "type": "number",
          "const": 3
        },
        {
          "type": "number",
          "const": 4
        }
      ]
    },
    "items": {
      "minItems": 1,
      "maxItems": 12,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "text": {
            "type": "string",
            "maxLength": 300
          },
          "icon": {
            "type": "string",
            "maxLength": 40
          },
          "image": {
            "type": "object",
            "properties": {
              "url": {
                "type": "string",
                "minLength": 1
              },
              "alt": {
                "default": "",
                "type": "string"
              },
              "width": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "height": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "caption": {
                "type": "string"
              },
              "blurDataURL": {
                "type": "string"
              },
              "focal": {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "y": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                },
                "required": ["x", "y"]
              }
            },
            "required": ["url", "width", "height"]
          },
          "link": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1
              },
              "href": {
                "type": "string",
                "minLength": 1
              },
              "external": {
                "default": false,
                "type": "boolean"
              },
              "variant": {
                "default": "primary",
                "type": "string",
                "enum": ["primary", "secondary", "ghost"]
              }
            },
            "required": ["label", "href"]
          }
        },
        "required": ["id", "title"]
      }
    }
  },
  "required": ["id", "_type", "items"]
}
