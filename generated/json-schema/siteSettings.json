{
  "$comment": "Generert fra src/content/schema – ikke rediger manuelt",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "tagline": {
      "type": "string",
      "maxLength": 160
    },
    "description": {
      "type": "string",
      "maxLength": 300
    },
    "logo": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "minLength": 1
        },
        "alt": {
          "default": "",
          "type": "string"
        },
        "width": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "height": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "caption": {
          "type": "string"
        },
        "blurDataURL": {
          "type": "string"
        },
        "focal": {
          "type": "object",
          "properties": {
            "x": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "y": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "required": [
            "x",
            "y"
          ]
        }
      },
      "required": [
        "url",
        "width",
        "height"
      ]
    },
    "logoDark": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "minLength": 1
        },
        "alt": {
          "default": "",
          "type": "string"
        },
        "width": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "height": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "caption": {
          "type": "string"
        },
        "blurDataURL": {
          "type": "string"
        },
        "focal": {
          "type": "object",
          "properties": {
            "x": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "y": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "required": [
            "x",
            "y"
          ]
        }
      },
      "required": [
        "url",
        "width",
        "height"
      ]
    },
    "defaultSeo": {
      "default": {
        "noindex": false
      },
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 70
        },
        "description": {
          "type": "string",
          "maxLength": 170
        },
        "image": {
          "type": "object",
          "properties": {
            "url": {
              "type": "string",
              "minLength": 1
            },
            "alt": {
              "default": "",
              "type": "string"
            },
            "width": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "height": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "caption": {
              "type": "string"
            },
            "blurDataURL": {
              "type": "string"
            },
            "focal": {
              "type": "object",
              "properties": {
                "x": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "y": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              },
              "required": [
                "x",
                "y"
              ]
            }
          },
          "required": [
            "url",
            "width",
            "height"
          ]
        },
        "noindex": {
          "default": false,
          "type": "boolean"
        },
        "canonical": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "contact": {
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "format": "email",
          "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
        },
        "phone": {
          "type": "string"
        },
        "address": {
          "type": "string"
        },
        "orgNumber": {
          "type": "string"
        }
      }
    },
    "social": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "platform": {
            "type": "string",
            "enum": [
              "linkedin",
              "instagram",
              "facebook",
              "youtube",
              "x",
              "tiktok",
              "github"
            ]
          },
          "url": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": [
          "platform",
          "url"
        ]
      }
    },
    "footerText": {
      "type": "string"
    },
    "sameAs": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri"
      }
    }
  },
  "required": [
    "name",
    "description",
    "contact"
  ]
}
