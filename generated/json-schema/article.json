{
  "$comment": "Generert fra src/content/schema – ikke rediger manuelt",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "slug": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "status": {
      "default": "published",
      "type": "string",
      "enum": [
        "draft",
        "published"
      ]
    },
    "_type": {
      "default": "article",
      "type": "string",
      "const": "article"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 140
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 400
    },
    "image": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "minLength": 1
        },
        "alt": {
          "default": "",
          "type": "string"
        },
        "width": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "height": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "caption": {
          "type": "string"
        },
        "blurDataURL": {
          "type": "string"
        },
        "focal": {
          "type": "object",
          "properties": {
            "x": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "y": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "required": [
            "x",
            "y"
          ]
        }
      },
      "required": [
        "url",
        "width",
        "height"
      ]
    },
    "authorId": {
      "type": "string"
    },
    "publishedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "categoryIds": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "body": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "_type": {
                "type": "string",
                "const": "block"
              },
              "style": {
                "default": "normal",
                "type": "string",
                "enum": [
                  "normal",
                  "h2",
                  "h3",
                  "h4",
                  "blockquote"
                ]
              },
              "listItem": {
                "type": "string",
                "enum": [
                  "bullet",
                  "number"
                ]
              },
              "level": {
                "type": "integer",
                "minimum": 1,
                "maximum": 3
              },
              "children": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "_type": {
                      "type": "string",
                      "const": "span"
                    },
                    "text": {
                      "type": "string"
                    },
                    "marks": {
                      "default": [],
                      "type": "array",
                      "items": {
                        "type": "string",
                        "enum": [
                          "strong",
                          "em",
                          "code",
                          "underline"
                        ]
                      }
                    },
                    "href": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "_type",
                    "text"
                  ]
                }
              }
            },
            "required": [
              "_type",
              "children"
            ]
          },
          {
            "type": "object",
            "properties": {
              "_type": {
                "type": "string",
                "const": "image"
              },
              "image": {
                "type": "object",
                "properties": {
                  "url": {
                    "type": "string",
                    "minLength": 1
                  },
                  "alt": {
                    "default": "",
                    "type": "string"
                  },
                  "width": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  },
                  "height": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  },
                  "caption": {
                    "type": "string"
                  },
                  "blurDataURL": {
                    "type": "string"
                  },
                  "focal": {
                    "type": "object",
                    "properties": {
                      "x": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "y": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      }
                    },
                    "required": [
                      "x",
                      "y"
                    ]
                  }
                },
                "required": [
                  "url",
                  "width",
                  "height"
                ]
              }
            },
            "required": [
              "_type",
              "image"
            ]
          }
        ]
      }
    },
    "sources": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1
          },
          "href": {
            "type": "string",
            "minLength": 1
          },
          "external": {
            "default": false,
            "type": "boolean"
          },
          "variant": {
            "default": "primary",
            "type": "string",
            "enum": [
              "primary",
              "secondary",
              "ghost"
            ]
          }
        },
        "required": [
          "label",
          "href"
        ]
      }
    },
    "seo": {
      "default": {
        "noindex": false
      },
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 70
        },
        "description": {
          "type": "string",
          "maxLength": 170
        },
        "image": {
          "type": "object",
          "properties": {
            "url": {
              "type": "string",
              "minLength": 1
            },
            "alt": {
              "default": "",
              "type": "string"
            },
            "width": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "height": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "caption": {
              "type": "string"
            },
            "blurDataURL": {
              "type": "string"
            },
            "focal": {
              "type": "object",
              "properties": {
                "x": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "y": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              },
              "required": [
                "x",
                "y"
              ]
            }
          },
          "required": [
            "url",
            "width",
            "height"
          ]
        },
        "noindex": {
          "default": false,
          "type": "boolean"
        },
        "canonical": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "agentMeta": {
      "type": "object",
      "properties": {
        "createdBy": {
          "type": "string"
        },
        "template": {
          "type": "string"
        },
        "templateVersion": {
          "type": "string"
        },
        "checkedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        "issues": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        }
      }
    }
  },
  "required": [
    "id",
    "slug",
    "createdAt",
    "updatedAt",
    "title",
    "summary",
    "authorId",
    "publishedAt",
    "body"
  ]
}
